# APP
PORT=3003
SERVICE_NAME=pets-service
NODE_ENV=development
LOG_LEVEL=info

# DATABASE
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_database_password
DB_NAME=your_database_name

# SECURITY
JWT_SECRET=your_jwt_secret_here

# SERVICES
AUTH_SERVICE_URL=http://localhost:3001

# AI RECOMMENDATIONS
# AI_RECOMMENDATIONS_ENABLED=false keeps the current rule-based fallback.
AI_RECOMMENDATIONS_ENABLED=false
AI_PROVIDER=openai
AI_API_KEY=replace_with_real_api_key
AI_MODEL=gpt-4o-mini
